# --- Estrategia de resolución del perfil (A | B | C | C_PRIME) ---
READ_STRATEGY=A

# --- Identificación de la corrida ---
RUN_ID=r1

# --- PostgreSQL (reglas de tarifa) ---
POSTGRES_USER=solventa
POSTGRES_PASSWORD=solventa
POSTGRES_DB=solventa

# --- API de cotización ---
UVICORN_WORKERS=2
DEPENDENCY_BUDGET_MS=120
HARD_TIMEOUT_MS=700
CIRCUIT_BREAKER_POLICY=count
CIRCUIT_BREAKER_THRESHOLD=5
CACHE_TTL_SECONDS=86400

# --- Doble del proveedor de Open Finance ---
PROVIDER_STATE=healthy
PROVIDER_LATENCY_MEDIAN_MS=80
PROVIDER_LATENCY_SIGMA=0.5

# --- Toxiproxy ---
TOXIPROXY_LISTEN=0.0.0.0:8474
