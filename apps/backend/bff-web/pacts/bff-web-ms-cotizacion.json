            "moneda": "COP",
            "nombre": "SOAT motocicleta"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.coberturas": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.coberturas[*].codigo": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.coberturas[*].limite": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^-?\\d+(\\.\\d+)?$"
                }
              ]
            },
            "$.coberturas[*].nombre": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.coberturas[*].unidad_limite": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^(SMLDV|MONEDA)$"
                }
              ]
            },
            "$.datos_riesgo": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "arrayContains",
                  "variants": [
                    {
                      "index": 0,
                      "rules": {
                        "$.maximo": {
                          "combine": "AND",
                          "matchers": [
                            {
                              "match": "regex",
                              "regex": "^-?\\d+(\\.\\d+)?$"
                            }
                          ]
                        },
                        "$.minimo": {
                          "combine": "AND",
                          "matchers": [
                            {
                              "match": "regex",
                              "regex": "^-?\\d+(\\.\\d+)?$"
                            }
                          ]
                        },
                        "$.nombre": {
                          "combine": "AND",
                          "matchers": [
                            {
                              "match": "type"
                            }
                          ]
                        }
                      }
                    },
                    {
                      "index": 1,
                      "rules": {
                        "$.nombre": {
                          "combine": "AND",
                          "matchers": [
                            {
                              "match": "type"
                            }
                          ]
                        },
                        "$.valores": {
                          "combine": "AND",
                          "matchers": [
                            {
                              "match": "type"
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              ]
            },
            "$.moneda": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^[A-Z]{3}$"
                }
              ]
            },
            "$.nombre": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
