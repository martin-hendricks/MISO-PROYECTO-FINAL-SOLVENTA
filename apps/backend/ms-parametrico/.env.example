# Vacío = los eventos quedan en memoria (solo desarrollo, sin bus).
MSK_BOOTSTRAP_BROKERS=localhost:9094
MSK_TOPIC=TopicoTelemetria
# AWS_MSK_IAM en EKS; PLAINTEXT contra el Kafka local de apps/backend/docker-compose.yml.
MSK_AUTH_MECHANISM=PLAINTEXT

# Credenciales del proveedor de telemetría (en EKS: secreto telemetria_iot, claves clientId/clientSecret).
TELEMETRIA_CLIENT_ID=proveedor-demo
TELEMETRIA_CLIENT_SECRET=cambiar-en-local

MAX_PUBLICACIONES_EN_VUELO=500
TIMEOUT_PUBLICACION_SEGUNDOS=5
REINTENTAR_DESPUES_SEGUNDOS=2
LOG_LEVEL=INFO
