            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/registro",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Ana\",\n  \"apellidos\": \"Torres\",\n  \"documento\": \"1020304050\",\n  \"correo\": \"ana@correo.com\",\n  \"habeasData\": true\n}",
          "options": {
