{
  "info": {
    "name": "Solventa local - api-socios",
    "description": "Pruebas de api-socios corriendo en tu máquina, sin environment: la URL va en la variable `baseUrl` de la colección (http://localhost:8090).\n\nArranque: `MS_COTIZACION_URL=http://localhost:8001 uvicorn app.main:app --port 8090`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "pm.test('status ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Catálogo (proxy a ms-cotizacion)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/v1/catalogo"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "pm.test('trae productos', () => pm.expect(pm.response.json().productos.length).to.be.above(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "Producto por código",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/v1/catalogo/{{productoCodigo}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Producto inexistente",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/v1/catalogo/no-existe"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404', () => pm.response.to.have.status(404));",
              "pm.test('codigo no_encontrado', () => pm.expect(pm.response.json().codigo).to.eql('no_encontrado'));"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8090"
    },
    {
      "key": "productoCodigo",
      "value": "soat-motocicleta"
    }
  ]
}
