{
  "info": {
    "name": "Solventa local - bff-movil",
    "description": "Pruebas de bff-movil corriendo en tu máquina, sin environment: la URL va en la variable `baseUrl` de la colección (http://localhost:8002).\n\nArranque: `SOLVENTA_TOKEN_SECRET=dev-local-secret uvicorn app.main:app --port 8002`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Registro de cliente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/registro",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Ana\",\n  \"apellidos\": \"Torres\",\n  \"documento\": \"1020304050\",\n  \"correo\": \"ana@correo.com\",\n  \"pruebaDeVida\": \"ok\",\n  \"habeasData\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "`pruebaDeVida` acepta `ok` (selfie aprobada) o `no` (el cliente la omite)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 o 201', () => pm.expect([200, 201]).to.include(pm.response.code));"
            ]
          }
        }
      ]
    },
    {
      "name": "Ingreso",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/sesion/ingreso",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo\": \"ana@correo.com\",\n  \"contrasena\": \"demo1234\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('tokenMovil', body.accessToken);",
              "pm.collectionVariables.set('refreshMovil', body.refreshToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Refresh",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/sesion/refresh",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshMovil}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Inicio del cliente",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/cliente/inicio",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenMovil}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Salida",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/sesion/salida",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenMovil}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8002"
    },
    {
      "key": "tokenMovil",
      "value": ""
    },
    {
      "key": "refreshMovil",
      "value": ""
    }
  ]
}
