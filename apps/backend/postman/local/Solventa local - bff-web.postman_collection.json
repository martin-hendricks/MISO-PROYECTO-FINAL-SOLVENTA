{
  "info": {
    "name": "Solventa local - bff-web",
    "description": "Pruebas de bff-web corriendo en tu máquina, sin environment: la URL va en la variable `baseUrl` de la colección (http://localhost:8000).\n\nArranque: `SOLVENTA_TOKEN_SECRET=dev-local-secret uvicorn app.main:app --port 8000`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Ingreso cliente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/sesion/ingreso",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo\": \"cliente@solventa.co\",\n  \"contrasena\": \"demo1234\",\n  \"rol\": \"cliente\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('tokenCliente', body.accessToken);",
              "pm.collectionVariables.set('refreshWeb', body.refreshToken);"
            ]
          }
        }
      ]
    },
