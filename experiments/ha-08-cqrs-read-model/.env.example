# Plantilla de configuracion del experimento HA-08.
# Copiar a .env (que NO se versiona) antes de la primera corrida:
#   cp .env.example .env
#
# Valores de referencia: Guia_Tecnica_HA-08.md, seccion 4.
# Las variables marcadas como CONTROLADA deben permanecer identicas
# entre brazos: cambiarlas invalida la comparacion.

# --- Estrategia de lectura (A | B | C | C_PRIME) ---
# Unica variable independiente que cambia entre brazos.
READ_STRATEGY=A

# --- Identificacion de la corrida (r1 | r2 | r3) ---
RUN_ID=r1

# --- PostgreSQL ---
POSTGRES_USER=solventa
POSTGRES_PASSWORD=solventa
POSTGRES_DB=solventa
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=512MB

# --- API ---
UVICORN_WORKERS=2      # CONTROLADA
DB_POOL_MIN=10         # CONTROLADA
DB_POOL_MAX=10         # CONTROLADA
CACHE_TTL_SECONDS=30   # Punto de sensibilidad 2: 0 | 30 | 300 (solo brazo C)

# --- Simulador ---
EVENTS_PER_SECOND=5    # CONTROLADA: proyeccion bajo actualizacion activa

# --- Dataset ---
TOTAL_SINIESTROS=1000000   # CONTROLADA
HOT_SET_SIZE=10000         # CONTROLADA
