# Normalizacion de fin de linea.
# Critico en Windows: los scripts se ejecutan dentro de contenedores Linux,
# un CRLF los rompe con "bad interpreter: /bin/bash^M".
* text=auto eol=lf

*.sh      text eol=lf
*.py      text eol=lf
*.sql     text eol=lf
*.js      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.md      text eol=lf
Dockerfile text eol=lf
.env*     text eol=lf

*.ps1     text eol=crlf
*.bat     text eol=crlf

# Binarios
*.png     binary
*.jpg     binary
*.pdf     binary
*.drawio  binary
