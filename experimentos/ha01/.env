# =====================================================================
# Experimento HA-01 — configuracion del montaje
# Ver Diseno_Experimento_HA-01.md (Anexo A y Anexo G)
# =====================================================================

# --- Umbrales del servicio (250/500 ms E2E menos 25 ms de borde) -----
# NO son 250/500: el montaje no incluye :ApiGateway.
SLO_P95_MS=225
SLO_P99_MS=475

# --- Brazo del experimento -------------------------------------------
# direct | cache_blocking | cache_opportunistic | cache_singleflight
QUOTE_STRATEGY=cache_opportunistic

# --- Presupuestos de latencia (EC-LAT-07 y EC-LAT-08) ----------------
# Presupuesto de la cotizacion: cuanto espera :MsCotizacion antes de abandonar
DEPENDENCY_BUDGET_MS=120
# Timeout duro del adaptador: cuanto espera :AdaptadorOF antes de rendirse
ADAPTER_HARD_TIMEOUT_MS=700
# Timeout de establecimiento de conexion (dentro del timeout duro)
ADAPTER_CONNECT_TIMEOUT_MS=200

# --- Interruptor de circuito -----------------------------------------
# count | rate
BREAKER_POLICY=rate
BREAKER_FAILURE_THRESHOLD=10        # fallos consecutivos, politica count
BREAKER_FAILURE_RATE=0.5            # proporcion de fallos, politica rate
BREAKER_WINDOW_SECONDS=10           # ventana deslizante, politica rate
BREAKER_MIN_SAMPLES=5               # minimo para evaluar la tasa
BREAKER_OPEN_SECONDS=15             # reposo antes de pasar a semiabierto
BREAKER_HALF_OPEN_PROBES=1          # sondas concurrentes permitidas en semiabierto

# --- Aislamiento de recursos (bulkhead) por proveedor ----------------
ADAPTER_MAX_CONNECTIONS=40
ADAPTER_MAX_KEEPALIVE=20
# Cota dura de tareas de refresco en vuelo (brazos C y C').
# 0 = sin cota. Se instrumenta el rechazo para no ocultar HD-01.7.
REFRESH_MAX_INFLIGHT=0

# --- Cache de perfil --------------------------------------------------
REDIS_URL=redis://redis:6379/0
PROFILE_TTL_SECONDS=900             # cuando conviene refrescar
PROFILE_MAX_AGE_SECONDS=86400       # hasta cuando sirve como valor de respaldo

# --- Motor de tarifa --------------------------------------------------
RATING_COST_MS=60                   # costo calibrado, constante entre brazos
RATING_CPU_ITERS=1200               # trabajo de CPU real dentro de ese costo

# --- Doble del proveedor: distribucion de latencia de aplicacion ------
# NOTA: la log-normal se ajusta con p50 y p95. P99 NO se controla: se usa
# solo como cota superior (x6). El p99 realizado con 60/110 es ~141 ms.
PROVIDER_LATENCY_P50_MS=60
PROVIDER_LATENCY_P95_MS=110
PROVIDER_LATENCY_P99_MS=180
PROVIDER_ERROR_RATE=0.0
PROVIDER_SEED=42

# --- Toxiproxy --------------------------------------------------------
TOXIPROXY_URL=http://localhost:8474
PROVIDER_UPSTREAM=provider:9000

# --- Dataset y control de la tasa de acierto --------------------------
# Tres pools disjuntos (ajuste al Anexo A, ver README seccion "Tasa de
# acierto estacionaria"). Garantizan que la tasa de acierto NO derive
# durante la corrida por repoblado de la cache.
UNIVERSO_CLIENTES=50000             # pool CALIENTE: precargado fresco
POOL_STALE=100000                   # pool VENCIDO: precargado con edad > TTL
POOL_COLD=100000                    # pool FRIO: espacio de ids nunca precargado
TARGET_HIT_RATE=0.96
MISS_STALE_FRACTION=0.5             # de los fallos, cuantos tienen valor de respaldo
# Edad del pool caliente repartida en 0..HOT_AGE_SPREAD_S. Precargarlo todo
# con la misma marca haria degenerada la variable "edad del dato servido".
# Debe quedar por debajo de PROFILE_TTL_SECONDS menos la duracion de la
# corrida, o las entradas venceran a mitad de ventana y el acierto derivara.
HOT_AGE_SPREAD_S=450

# --- Carga ------------------------------------------------------------
K6_RATE=100                         # solicitudes por segundo (tasa de llegada)
K6_DURATION=5m
K6_WARMUP=60s

# --- API --------------------------------------------------------------
# 1 worker OBLIGATORIO: el interruptor y el registro Prometheus viven en
# proceso. Con 2 workers habria dos interruptores y el scrape caeria en
# uno u otro, invalidando toda la instrumentacion.
UVICORN_WORKERS=1
LOG_LEVEL=warning
