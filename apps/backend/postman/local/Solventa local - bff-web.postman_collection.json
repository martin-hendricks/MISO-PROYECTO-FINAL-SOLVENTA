      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 o 201', () => pm.expect([200, 201]).to.include(pm.response.code));"
            ]
          }
        }
      ]
    },
    {
      "name": "Asesor - listar clientes",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/asesor/clientes",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenAsesor}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "pm.test('trae clientes', () => pm.expect(pm.response.json().clientes.length).to.be.above(0));"
            ]
          }
        }
      ]
    },
