{
  "consumer": {
    "name": "bff-movil"
  },
  "interactions": [
    {
      "description": "las ciudades con prestadores activos de Perú para el cliente móvil",
      "pending": false,
      "providerStates": [
        {
          "name": "hay prestadores sembrados en cuatro países"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/v1/prestadores/ciudades",
        "query": {
          "con_prestadores": [
            "true"
          ],
          "pais": [
            "PE"
          ]
        }
      },
      "response": {
        "body": {
          "content": {
            "ciudades": [
              {
                "lat": "-12.046400",
                "lng": "-77.042800",
                "nombre": "Lima",
                "prestadores": 5,
                "zoom": 11
              }
            ],
            "pais": "PE"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.ciudades": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.ciudades[*].lat": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^-?\\d+(\\.\\d+)?$"
                }
              ]
            },
            "$.ciudades[*].lng": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^-?\\d+(\\.\\d+)?$"
                }
              ]
            },
            "$.ciudades[*].nombre": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.ciudades[*].prestadores": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.ciudades[*].zoom": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    },
